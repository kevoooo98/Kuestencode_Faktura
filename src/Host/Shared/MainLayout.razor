@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@using Kuestencode.Werkbank.Host.Auth
@using Kuestencode.Werkbank.Host.Services
@implements IDisposable

<MudThemeProvider @ref="_themeProvider" Theme="@_theme" IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudStack Row="false" Spacing="0" Class="ml-3">
            <MudText Typo="Typo.h5">Küstencode Werkbank</MudText>
        </MudStack>
        <MudSpacer />
        <MudTooltip Text="@(_isDarkMode ? "Hell-Modus" : "Dunkel-Modus")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                          Color="Color.Inherit"
                          OnClick="@ToggleDarkMode" />
        </MudTooltip>
        @if (_authEnabled)
        {
            <MudTooltip Text="Abmelden">
                <MudIconButton Icon="@Icons.Material.Filled.Logout"
                              Color="Color.Inherit"
                              OnClick="@HandleLogout" />
            </MudTooltip>
        }
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4 pt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<MudText Typo="Typo.caption" Style="position:fixed; bottom:8px; left:8px; opacity:0.6; z-index:2000;">
    Host @_hostVersion
</MudText>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private bool _authEnabled = false;
    private MudBlazor.MudTheme _theme = KuestenCodeTheme.Theme;
    private MudThemeProvider? _themeProvider;
    private string _hostVersion => Configuration["MODULE_VERSION"]
        ?? Configuration["IMAGE_TAG"]
        ?? Configuration["DOCKER_IMAGE_TAG"]
        ?? "dev";

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to authentication state changes
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await CheckAuthStatus();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Lade gespeicherte Theme-Präferenz aus localStorage
            var isDarkModeStored = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "darkMode");
            if (!string.IsNullOrEmpty(isDarkModeStored) && bool.TryParse(isDarkModeStored, out bool storedValue))
            {
                _isDarkMode = storedValue;
                StateHasChanged();
            }

        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await CheckAuthStatus();
    }

    private async Task CheckAuthStatus()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            // If NoAuth, authentication is disabled
            _authEnabled = user.Identity?.AuthenticationType != "NoAuth" && user.Identity?.IsAuthenticated == true;
            StateHasChanged();
        }
        catch
        {
            _authEnabled = false;
        }
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;

        // Speichere Präferenz in localStorage
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "darkMode", _isDarkMode.ToString());
    }

    async Task HandleLogout()
    {
        try
        {
            await JSRuntime.InvokeAsync<bool>("werkbankAuth.logout");
        }
        catch
        {
            // Ignore errors and continue with local logout state.
        }

        if (AuthStateProvider is WerkbankAuthStateProvider werkbankAuth)
        {
            await werkbankAuth.LogoutAsync();
        }

        NavigationManager.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}

